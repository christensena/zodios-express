{
  "name": "@zodios/express",
  "description": "Typescript express server",
  "version": "10.6.1",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "author": {
    "name": "ecyrbe",
    "email": "ecyrbe@gmail.com"
  },
  "homepage": "https://github.com/ecyrbe/zodios-express",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecyrbe/zodios-express.git"
  },
  "license": "MIT",
  "keywords": [
    "express",
    "zod",
    "rpc",
    "validation"
  ],
  "scripts": {
    "prebuild": "rimraf lib",
    "example": "ts-node examples/jsonplaceholder.ts",
    "major-rc": "npm version premajor --preid=rc",
    "minor-rc": "npm version preminor --preid=rc",
    "patch-rc": "npm version prepatch --preid=rc",
    "rc": "npm version prerelease --preid=rc",
    "build": "tsup",
    "test": "jest --coverage"
  },
  "peerDependencies": {
    "@zodios/core": ">=10.4.4 <11.0.0",
    "express": "4.x",
    "zod": "^3.x"
  },
  "devDependencies": {
    "@jest/types": "^30.4.1",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "@zodios/core": "10.9.6",
    "axios": "1.20.0",
    "express": "4.22.2",
    "jest": "30.4.2",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
